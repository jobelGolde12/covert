{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio — document conversion with style and substance. Browser-first converter (private by default) with a LibreOffice-backed server pipeline.",
  "scripts": {
    "copy:pdfjs": "node scripts/copy-pdfjs-worker.mjs",
    "postinstall": "node scripts/copy-pdfjs-worker.mjs",
    "predev": "node scripts/copy-pdfjs-worker.mjs",
    "prebuild": "node scripts/copy-pdfjs-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:office": "tsx workers/office/index.ts",
    "worker:sweeper": "tsx workers/sweeper/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.0",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "next": "14.2.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.28",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
