# --- Database (SQLite local dev; Turso/libSQL in production) ---
DATABASE_URL="file:./dev.db"

# --- Redis (Bull queue + rate limits). Optional in dev: falls back to in-memory. ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Upload signing secret (local storage adapter) ---
UPLOAD_SECRET="dev-only-change-me"

# --- Retention (hours): anonymous / free / paid ---
RETENTION_ANON_HOURS="1"
RETENTION_FREE_HOURS="24"
RETENTION_PAID_HOURS="168"

# --- Anonymous rate limits ---
ANON_CONVERSIONS_PER_DAY="5"
ANON_REQ_PER_MIN="60"

# --- Cloudflare R2 (production). Local dev uses the filesystem adapter. ---
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="convert-files"
# R2_PUBLIC_URL=""

# --- LibreOffice worker ---
LO_CONCURRENCY="1"
LO_TIMEOUT_MS="900000"
LO_PROFILE_ROOT="/tmp/lo-profiles"

# --- Public URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
